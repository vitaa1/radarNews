# Copie este arquivo para local/.env e troque somente os valores abaixo.
# Nunca envie local/.env para GitHub, e-mail ou mensagens.
WORKER_URL=https://radar-news.SEUSUBDOMINIO.workers.dev
SHARED_SECRET=cole_a_mesma_chave_aleatoria_cadastrada_no_worker

# O Ollama normalmente usa estes valores locais.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Intervalo entre consultas ao Worker e quantidade processada por vez.
LOCAL_POLL_SECONDS=60
LOCAL_BATCH_SIZE=3
